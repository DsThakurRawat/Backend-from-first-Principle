---
// Light/dark toggle. The pre-paint script in Base.astro owns the initial
// value; this only handles the click and keeps localStorage in sync.
---
<button class="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
  <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" />
  </svg>
  <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    transition: color 120ms ease, border-color 120ms ease, background-color 120ms ease;
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--line-2); }
  .theme-toggle svg { width: 16px; height: 16px; }

  /* One icon per theme; the other is removed from the box entirely. */
  .theme-toggle .i-moon { display: none; }
  :global(:root[data-theme='dark']) .theme-toggle .i-sun { display: none; }
  :global(:root[data-theme='dark']) .theme-toggle .i-moon { display: block; }
</style>

<script>
  const KEY = 'bfp-theme';
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem(KEY, next); } catch { /* storage blocked */ }
    });
  });
</script>
